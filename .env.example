# ============ Core (not from our code, match your app) ============
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docgpt   # Postgres must have pgvector installed
TEMPORAL_ADDRESS=localhost:7233        # names are a guess, match your worker config
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=docgpt-ingestion
# Add your own: JWT/session secret, OAuth client IDs and secrets for your auth providers, frontend URL

# ============ Uploads and loader ============
MAX_UPLOAD_BYTES=26214400              # 25 MB
LOADER_MAX_PAGES=500

# ============ Storage ============
STORAGE_DRIVER=local                   # local | s3 | r2 (used for NEW uploads)
STORAGE_ENABLED_DRIVERS=local          # keep old drivers listed so their files stay readable

# local driver (var names are placeholders, match what your module reads)
STORAGE_LOCAL_SECRET=change-me-generate-with-openssl-rand-hex-32   # must be 32+ characters
STORAGE_LOCAL_DIR=./storage-data
API_PUBLIC_URL=http://localhost:4000

# s3 driver (uncomment when STORAGE_DRIVER=s3; names are placeholders)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                         # MinIO only
# S3_PUBLIC_ENDPOINT=                  # MinIO only, host the browser can reach
# S3_FORCE_PATH_STYLE=true             # MinIO only

# r2 driver (uncomment when STORAGE_DRIVER=r2; names are placeholders)
# R2_BUCKET=
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ============ Chunker ============
CHUNKER_STRATEGY=recursive             # recursive | fixed
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64                # must be smaller than CHUNK_MAX_TOKENS

# ============ Embedder ============
EMBEDDING_PROVIDER=openai              # openai | local
OPENAI_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536              # must match the HNSW index in the migration
# OPENAI_BASE_URL=https://api.openai.com/v1

# local embeddings (use these with EMBEDDING_PROVIDER=local, for example Ollama)
# LOCAL_EMBEDDING_MODEL=nomic-embed-text
# LOCAL_EMBEDDING_DIMENSIONS=768
# LOCAL_EMBEDDING_MAX_TOKENS=2048
# LOCAL_EMBEDDING_BASE_URL=http://localhost:11434/v1
# LOCAL_EMBEDDING_DOCUMENT_PREFIX=search_document:
# LOCAL_EMBEDDING_QUERY_PREFIX=search_query:

# ============ Contextualizer ============
CONTEXTUALIZER_PROVIDER=none           # none | anthropic | local
CONTEXT_MAX_TOKENS=100

# anthropic (use these with CONTEXTUALIZER_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# CONTEXTUALIZER_MODEL=claude-haiku-5-5
# CONTEXTUALIZER_CONCURRENCY=8
# CONTEXTUALIZER_WINDOW_TOKENS=60000
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# local (use these with CONTEXTUALIZER_PROVIDER=local, for example Ollama)
# LOCAL_CONTEXTUALIZER_MODEL=llama3.2:3b
# LOCAL_CONTEXTUALIZER_BASE_URL=http://localhost:11434/v1
# LOCAL_CONTEXTUALIZER_WINDOW_TOKENS=3000   # raise Ollama's context length to match
# LOCAL_CONTEXTUALIZER_CONCURRENCY=2
# LOCAL_CONTEXTUALIZER_API_KEY=

# ============ Chat ============
CHAT_TOP_K=6
CHAT_HISTORY_MESSAGES=10

# ============ Retrieval (planned, nothing reads these yet) ============
# RETRIEVAL_FETCH_K=50
# RRF_K=60
# RERANK_TOP_N=40
# RERANK_PROVIDER=none                 # cohere | tei | llm | none
# CHAT_CONTEXT_TOKENS=6000

# ingestion
CONTEXTUALIZER_PROVIDER=none|anthropic|local     # default none
CONTEXTUALIZER_MODEL=                            # default claude-haiku-5-5 / llama3.1:8b
CONTEXT_MAX_TOKENS=100   
CONTEXTUALIZER_CONCURRENCY=4   
CONTEXTUALIZER_MAX_DOC_TOKENS=
ANTHROPIC_API_KEY=       # anthropic
CONTEXTUALIZER_BASE_URL= # local, default http://localhost:11434/v1

# query time
RETRIEVAL_FETCH_K=50   
RRF_K=60   
RERANK_TOP_N=40   
CHAT_CONTEXT_TOKENS=6000
RERANK_PROVIDER=none|cohere|tei|llm              # default none
COHERE_API_KEY=          # cohere
RERANK_BASE_URL=         # tei, for example http://reranker:8080
RETRIEVAL_MIN_RERANK_SCORE=0   
RERANK_TIMEOUT_MS=
PGVECTOR_ITERATIVE_SCAN=true   
RETRIEVAL_TRACE=false

BILLING_ENABLED=true            # unset for self-hosted
BILLING_PROVIDERS=razorpay,dodo # add stripe if you get an invite
BILLING_ROUTES=IN:razorpay,*:dodo
BILLING_GRACE_DAYS=3
APP_URL=https://app.example.com

# price ids: {PROVIDER}_PRICE_{PLAN}_{INTERVAL}
RAZORPAY_PRICE_PRO_MONTH=plan_...   
RAZORPAY_PRICE_PRO_YEAR=plan_...
DODO_PRICE_PRO_MONTH=pdt_...        
DODO_PRICE_PRO_YEAR=pdt_...
STRIPE_PRICE_PRO_MONTH=price_...    
STRIPE_PRICE_PRO_YEAR=price_...

RAZORPAY_KEY_ID=  
RAZORPAY_KEY_SECRET=  
RAZORPAY_WEBHOOK_SECRET=
DODO_PAYMENTS_API_KEY=  
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...  
DODO_PAYMENTS_ENVIRONMENT=test_mode|live_mode
STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=